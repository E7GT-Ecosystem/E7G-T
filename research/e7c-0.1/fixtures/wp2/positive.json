{
  "environment": {
    "variables": {
      "source_config": {"tag": "config", "args": ["Sigma-A"]},
      "source_family": {"tag": "family", "args": ["I", {"tag": "config", "args": ["Sigma-A"]}]},
      "source_view": {"tag": "view", "args": [{"tag": "config", "args": ["Sigma-A"]}, {"tag": "base", "args": ["Summary"]}, "inventory"]},
      "source_fibre": {"tag": "fibre", "args": [{"tag": "config", "args": ["Sigma-A"]}, "exact_reconstruction"]}
    },
    "maps": {
      "strict_normalise": {
        "source": {"tag": "config", "args": ["Sigma-A"]},
        "target": {"tag": "config", "args": ["Sigma-B"]},
        "domain_policy": "strict",
        "map_edition": "map-1",
        "outcome_extension": "core-1"
      }
    },
    "views": {
      "lossy_projection": {
        "source": {"tag": "config", "args": ["Sigma-A"]},
        "target": {"tag": "base", "args": ["Summary"]},
        "inquiry": "inventory",
        "loss": ["history", "ordering"]
      }
    },
    "restrictions": {
      "select_J": {
        "input_index": "I",
        "output_index": "J",
        "element": {"tag": "config", "args": ["Sigma-A"]},
        "outcome_extension": "core-1"
      }
    },
    "reconstructions": {
      "exact_reconstruction": {
        "source": {"tag": "config", "args": ["Sigma-A"]},
        "view_type": {"tag": "base", "args": ["Summary"]},
        "inquiry": "inventory",
        "resource_policies": ["bounded-100"],
        "outcome_extension": "core-1"
      }
    },
    "criteria": {
      "phase_by_shape": {
        "source": {"tag": "fibre", "args": [{"tag": "config", "args": ["Sigma-A"]}, "exact_reconstruction"]},
        "outcome_extension": "core-1"
      }
    }
  },
  "cases": [
    {
      "id": "variable",
      "term": {"tag": "var", "name": "source_config"},
      "expected": {"type": "Config[\"Sigma-A\"]", "effects": []}
    },
    {
      "id": "strict_apply",
      "term": {"tag": "apply", "declaration": "strict_normalise", "arg": {"tag": "var", "name": "source_config"}},
      "expected": {"type": "Outcome[Config[\"Sigma-B\"],\"core-1\"]", "effects": [{"dimension": "partiality", "payload": "strict@map-1"}]}
    },
    {
      "id": "lossy_view",
      "term": {"tag": "view", "declaration": "lossy_projection", "arg": {"tag": "var", "name": "source_config"}},
      "expected": {"type": "View[Config[\"Sigma-A\"],Base[\"Summary\"],\"inventory\"]", "effects": [{"dimension": "inquiry", "payload": "inventory"}, {"dimension": "loss", "payload": "history,ordering"}]}
    },
    {
      "id": "restriction",
      "term": {"tag": "restrict", "declaration": "select_J", "arg": {"tag": "var", "name": "source_family"}},
      "expected": {"type": "Outcome[Family[\"J\",Config[\"Sigma-A\"]],\"core-1\"]", "effects": [{"dimension": "alternatives", "payload": "select_J"}]}
    },
    {
      "id": "reconstruction",
      "term": {"tag": "reconstruct", "declaration": "exact_reconstruction", "resource_policy": "bounded-100", "arg": {"tag": "var", "name": "source_view"}},
      "expected": {"type": "Outcome[Fibre[Config[\"Sigma-A\"],\"exact_reconstruction\"],\"core-1\"]", "effects": [{"dimension": "alternatives", "payload": "exact_reconstruction"}, {"dimension": "resources", "payload": "bounded-100"}]}
    },
    {
      "id": "classification",
      "term": {"tag": "classify", "declaration": "phase_by_shape", "arg": {"tag": "var", "name": "source_fibre"}},
      "expected": {"type": "Outcome[Partition[Fibre[Config[\"Sigma-A\"],\"exact_reconstruction\"],\"phase_by_shape\"],\"core-1\"]", "effects": [{"dimension": "inquiry", "payload": "phase_by_shape"}]}
    }
  ]
}
